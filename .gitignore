# --- real code lives outside these; everything below is generated/runtime state ---

__pycache__/
*.pyc
.venv/
.pytest_cache/
.env
*.egg-info/
.ruff_cache/

# Local playground/scratch project state -- created by running
# `orchestrator/cli.py` directly against the repo root instead of a real
# project's host-path (or without --state-path). Never intentional output;
# never something a fresh clone should contain.
.agentic-dev/

# Per-project agent state when a real project happens to be mounted inside
# this repo during manual testing (docker/spike/demo.py itself always uses
# /tmp/demo/... and never writes here).
workspace/*
!workspace/.gitkeep

# compose.yaml's default agent-state and project-source bind mounts --
# generated project state, and a project's own real source, for every
# project run through the container topology. Neither belongs in this
# repo's history.
data/agent-state/*
!data/agent-state/.gitkeep
data/projects/*
!data/projects/.gitkeep

# tools/dart_indexer/'s pub cache (regenerated by `dart pub get`).
# pubspec.lock IS committed -- dart_indexer is an application (has bin/),
# and Dart's own convention is to lock applications, not libraries.
tools/dart_indexer/.dart_tool/
