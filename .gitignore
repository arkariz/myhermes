# --- real code lives outside these; everything below is generated/runtime state ---

__pycache__/
*.pyc
.venv/
.pytest_cache/
.env
*.egg-info/
.ruff_cache/

# Local playground/scratch project state -- created by running
# `agentic project new` directly against the repo root instead of a real
# project's host-path (or without --state-path). Never intentional output;
# never something a fresh clone should contain.
.agentic-dev/

# tools/dart_indexer/'s pub cache (regenerated by `dart pub get`).
# pubspec.lock IS committed -- dart_indexer is an application (has bin/),
# and Dart's own convention is to lock applications, not libraries.
tools/dart_indexer/.dart_tool/
