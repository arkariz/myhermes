# Copy to .env and fill in. Never commit the real file.

# Gateway (LiteLLM by default; point at KeiRouter's base URL to swap it in)
AGENTIC_GATEWAY_URL=http://gateway:4000/v1
OPENROUTER_API_KEY=

# Per-role model overrides (see config/models.yaml)
PLANNER_MODEL=anthropic/claude-sonnet-4.6
DESIGNER_MODEL=anthropic/claude-sonnet-4.6
ARCHITECT_MODEL=anthropic/claude-sonnet-4.6
BUILDER_MODEL=deepseek/deepseek-v3
REVIEWER_MODEL=deepseek/deepseek-v3
QA_MODEL=deepseek/deepseek-v3
SUMMARIZER_MODEL=deepseek/deepseek-v3

# Telegram (Phase 2)
TELEGRAM_BOT_TOKEN=
TELEGRAM_FORUM_CHAT_ID=
TELEGRAM_DEFAULT_HOST_ROOT=/workspace/projects

# compose.yaml -- where agent-state and project source live on the host
# (bind-mounted into both containers, at /workspace/agent-state and
# /workspace/projects respectively). Leave unset to use ./data/agent-state
# and ./data/projects.
AGENT_STATE_DIR=
PROJECTS_DIR=

# Host paths for the first registered project (see scripts/new-project.sh)
AGENTIC_WORKSPACE_ROOT=D:/Projects
