# Copy to .env and fill in. Never commit the real file.

OPENROUTER_API_KEY=

# Per-role model overrides (see config/models.yaml's own ${VAR:-default}
# placeholders) -- commented out on purpose. compose.yaml forwards this
# whole file into the orchestrator container via env_file:, so an
# uncommented line here would silently override models.yaml's shipped
# default for every fresh setup, not just the one deployment that actually
# wants a different model.
# AUDITOR_MODEL=anthropic/claude-sonnet-4.6
# PLANNER_MODEL=anthropic/claude-sonnet-4.6
# DESIGNER_MODEL=anthropic/claude-sonnet-4.6
# ARCHITECT_MODEL=anthropic/claude-sonnet-4.6
# BUILDER_MODEL=deepseek/deepseek-v3
# REVIEWER_MODEL=deepseek/deepseek-v3
# QA_MODEL=deepseek/deepseek-v3
# SUMMARIZER_MODEL=deepseek/deepseek-v3

# Telegram (Phase 2)
TELEGRAM_BOT_TOKEN=
TELEGRAM_FORUM_CHAT_ID=
TELEGRAM_DEFAULT_HOST_ROOT=/workspace/projects

# Where the workspace repo lives on the host -- bind-mounted into both
# containers at /workspace (compose.yaml). Commented out on purpose, same
# reasoning as the model overrides above: both Dockerfiles bake
# ENV AGENTIC_WORKSPACE=/workspace as the in-container default, but
# compose.yaml forwards this whole file via env_file:, and a runtime env
# var -- even set to an EMPTY string -- overrides an image's baked ENV.
# Uncommenting this blank would silently break workspace resolution
# inside every container. Leave commented to use the default sibling
# location, ../agentic-workspace relative to this code repo; uncomment
# only if you actually want a different path.
# AGENTIC_WORKSPACE=/path/to/your/workspace
